# Public site URL (used by sitemap.xml + robots.txt — no trailing slash)
NEXT_PUBLIC_SITE_URL=https://rafricasafaris.com

# Bókun booking widgets
NEXT_PUBLIC_BOKUN_CHANNEL_UUID=c9a54988-3ddc-4447-83f5-8f17db125c37
# Product list id (experience-list widget)
NEXT_PUBLIC_BOKUN_FEATURED_LIST_ID=146387
# Featured experience id used on Explore (experience widget)
NEXT_PUBLIC_BOKUN_FEATURED_EXPERIENCE_ID=1284030
NEXT_PUBLIC_BOKUN_DEFAULT_CURRENCY=USD

# WhatsApp (E.164 digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=263775321238

# SMTP (booking emails → admin + guest confirmation)
SMTP_HOST=smtp.itanywhere.africa
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@shearwatervf.com
SMTP_PASS=

# Sender and inbox (From should match SMTP_USER; BOOKING_INBOX is admin)
EMAIL_FROM=noreply@shearwatervf.com
BOOKING_INBOX=info@rafricasafaris.com

# Bókun REST / OCTO API (server-side only — do not expose publicly)
BOKUN_API_BASE=https://api.bokun.is
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_OCTO_KEY=
